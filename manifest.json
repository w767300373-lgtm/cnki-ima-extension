{
  "manifest_version": 3,
  "name": "知网 PDF 入 ima",
  "version": "0.3.0",
  "description": "将当前有权下载的知网单篇论文 PDF 上传到所选 ima 知识库",
  "permissions": ["storage", "activeTab", "scripting", "declarativeNetRequest", "cookies"],
  "host_permissions": [
    "https://*.cnki.net/*",
    "https://ima.qq.com/*",
    "https://*.myqcloud.com/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [{
    "matches": ["https://*.cnki.net/*"],
    "js": ["src/cnki.js", "src/transfer.js", "src/page-content.js", "src/content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "知网 PDF 入 ima", "default_popup": "popup/popup.html" },
  "options_page": "options/options.html"
}
